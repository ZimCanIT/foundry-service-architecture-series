# Terraform working directories and local state
**/.terraform/*
node_modules/
npm-debug.log*
# Provider selections are committed only for the independent environment roots.
/modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Terraform plans and crash logs
*.tfplan
crash.log
crash.*.log

# Local variable files may contain credentials or environment-specific values
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Per-developer overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
.venv/
__pycache__/
*.py[cod]

# Local Terraform backend configuration, which can contain storage credentials
*.tfbackend
*.tfbackend.hcl

# Local Codex instructions
/AGENTS.md
/.codex/

# Local documentation content
/docs/

# Local Node.js version preference
/.nvmrc

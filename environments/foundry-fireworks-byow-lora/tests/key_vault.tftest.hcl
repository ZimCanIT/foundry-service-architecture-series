# Plan-only tests for the optional Key Vault. Every provider is mocked and both modules are
# overridden, so nothing here reaches Azure and no credentials are needed.

mock_provider "azurerm" {}
mock_provider "azapi" {}
mock_provider "random" {}

override_module {
  target = module.foundry
  outputs = {
    account_id                    = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-byow-lora-uat-uks-001/providers/Microsoft.CognitiveServices/accounts/aif-byow-lora-uat-uks-001-abcde"
    account_name                  = "aif-byow-lora-uat-uks-001-abcde"
    account_endpoint              = "https://aif-byow-lora-uat-uks-001-abcde.cognitiveservices.azure.com/"
    project_id                    = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-byow-lora-uat-uks-001/providers/Microsoft.CognitiveServices/accounts/aif-byow-lora-uat-uks-001-abcde/projects/proj-byow-lora-uat-uks-001"
    project_name                  = "proj-byow-lora-uat-uks-001"
    project_endpoint              = "https://aif-byow-lora-uat-uks-001-abcde.services.ai.azure.com/api/projects/proj-byow-lora-uat-uks-001"
    project_identity_principal_id = "44444444-4444-4444-4444-444444444444"
  }
}

override_module {
  target = module.azure_monitor
  outputs = {
    log_analytics_workspace_id             = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-byow-lora-uat-uks-001/providers/Microsoft.OperationalInsights/workspaces/log-byow-lora-uat-uks-001"
    log_analytics_workspace_customer_id    = "55555555-5555-5555-5555-555555555555"
    application_insights_id                = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-byow-lora-uat-uks-001/providers/Microsoft.Insights/components/appi-byow-lora-uat-uks-001"
    application_insights_connection_string = "InstrumentationKey=66666666-6666-6666-6666-666666666666"
  }
}

override_data {
  target = data.azurerm_client_config.current
  values = {
    object_id = "22222222-2222-2222-2222-222222222222"
  }
}

variables {
  subscription_id     = "00000000-0000-0000-0000-000000000000"
  tenant_id           = "11111111-1111-1111-1111-111111111111"
  workload_name       = "byow-lora"
  business_unit       = "Training"
  data_classification = "Internal"
  criticality         = "Low"
  service_level       = "Standard"
  support_group       = "Platform operations"
  department          = "Engineering"
  resource_group_name = "rg-byow-lora-uat-uks-001"
  location            = "uksouth"
  region_code         = "uks"
  instance            = "001"
  environment         = "uat"
  owner               = "Platform team"
  ops_team            = "Platform operations"
  project             = "byow-lora"
  managed_by          = "terraform"

  budget = {
    amount                = 100
    start_date            = "2026-11-01T00:00:00Z"
    alert_email_addresses = ["name@example.com"]
  }
}

run "off_by_default" {
  command = plan

  assert {
    condition     = var.key_vault.enabled == false
    error_message = "The Key Vault must be off by default."
  }

  assert {
    condition     = length(azurerm_key_vault.fireworks) == 0
    error_message = "No Key Vault may be planned by default."
  }

  assert {
    condition     = length(azurerm_role_assignment.key_vault_secrets_officer) == 0
    error_message = "No Key Vault role assignment may be planned by default."
  }

  assert {
    condition     = length(random_string.key_vault_suffix) == 0
    error_message = "No Key Vault name suffix may be generated by default."
  }

  assert {
    condition     = length(azurerm_monitor_diagnostic_setting.key_vault) == 0
    error_message = "No Key Vault diagnostic setting may be planned by default."
  }

  assert {
    condition     = output.key_vault_name == null
    error_message = "The key_vault_name output must be null by default."
  }
}

run "name_too_long" {
  command = plan

  # The 8-character stem, 7-character environment and 5-character region code, plus the prefix
  # and suffix, make a name of 31 characters, which is over the 24-character limit.
  variables {
    environment = "staging"
    region_code = "ukswe"
    key_vault = {
      enabled   = true
      name_stem = "abcdefgh"
    }
  }

  expect_failures = [
    azurerm_key_vault.fireworks,
  ]
}

run "key_vault_enabled" {
  command = plan

  variables {
    key_vault = {
      enabled = true
    }
  }

  assert {
    condition     = length(azurerm_key_vault.fireworks) == 1 && azurerm_key_vault.fireworks[0].rbac_authorization_enabled
    error_message = "Enabling the vault must plan one RBAC vault."
  }

  assert {
    condition     = length(azurerm_role_assignment.key_vault_secrets_officer) == 1 && azurerm_role_assignment.key_vault_secrets_officer[0].role_definition_name == "Key Vault Secrets Officer"
    error_message = "The deploying user must get Key Vault Secrets Officer on the vault."
  }

  assert {
    condition     = length(azurerm_monitor_diagnostic_setting.key_vault) == 1
    error_message = "The vault must send AuditEvent logs to the workspace."
  }
}
